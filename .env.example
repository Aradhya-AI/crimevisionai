# CrimeVision AI - Environment Configuration Example

# Backend Environment
APP_ENV=development
APP_NAME=CrimeVision AI
API_PREFIX=/api
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Security & CORS
SECRET_KEY=change-this-in-production-to-a-secure-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://crimevision-ai.vercel.app

# Database
# Local SQLite default (persisted in backend/data/crimevision.db)
DATABASE_URL=sqlite:///./data/crimevision.db
# For PostgreSQL in production (e.g. Render/Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/crimevision_db

# Storage
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=100

# Groq LLM API (for grounded evidence reasoning & timeline analysis)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Fallback models: llama-3.1-8b-instant, mixtral-8x7b-32768

# AI Inference Execution Mode
# Options: DEMO (synthetic/instant test data), LOCAL_AI (PyTorch/Transformers/OpenCV), GROQ (LLM reasoning enabled)
AI_MODE=DEMO
DEVICE=cpu

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:8000/api
